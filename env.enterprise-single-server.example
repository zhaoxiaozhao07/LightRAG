# =============================================================================
# LightRAG 企业级 · 单机内网 部署配置模板（中文注释）
# =============================================================================
# 适用场景：单台服务器、内网使用、开启企业认证（多用户 / RBAC / 多租户 / 审计），
#           不接入 SSO/OIDC/SAML（内网自管用户即可）。
#
# 使用方法：
#   1) 复制为 .env：       cp env.enterprise-single-server.example .env
#   2) 把所有【必改】项替换为你的真实值（地址/密钥/密码哈希）
#   3) 收紧文件权限：       chmod 600 .env        # 内含数据库/对象存储/模型服务密钥
#   4) 用防火墙把对外端口（默认 9621）限制在内网网段
#
# 标记说明：
#   【必改】= 密钥/地址，必须替换         【可调】= 容量/行为参数，按机器酌情调
#   【勿改】= 本场景推荐保持该值
#
# 配置层级：本文件是“部署级”配置（整台服务器一次性生效），import 时由 config.py
#           读入；真实环境变量可覆盖本文件（override=False）。各知识库自身的
#           parser/chunk/embedding/query 配置请走 /kbs/{id}/configs 接口，不在这里。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 基础运行
# -----------------------------------------------------------------------------
LIGHTRAG_RUNTIME_TARGET=host
HOST=0.0.0.0                       # 监听所有网卡；内网部署务必用防火墙限制访问来源
PORT=9621
WORKERS=1                          # 【勿改】durable worker 与流水线按单进程设计；多 worker 需额外协调
TIMEOUT=600
WORKING_DIR=./rag_storage          # 引擎本地落盘根目录（外部后端模式下主要存缓存/状态）
INPUT_DIR=./inputs                 # 上传源文件/解析产物的本地缓存目录
TIKTOKEN_CACHE_DIR=./data/tiktoken
WORKSPACE=                         # 全局默认 workspace；多 KB 模式下各 KB 自带 workspace，留空即可
WEBUI_TITLE='My Graph KB'
WEBUI_DESCRIPTION='Simple and Fast Graph Based RAG System'
LOG_LEVEL=INFO
VERBOSE=False
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# -----------------------------------------------------------------------------
# 2. 企业认证（核心）—— 开启后用户/租户/权限/审计改由 Admin API 运行时管理
# -----------------------------------------------------------------------------
LIGHTRAG_ENTERPRISE_AUTH_ENABLED=true        # 【勿改】总开关：激活 RBAC/多租户/ACL/审计/service key

# JWT 签名密钥：【必改】强随机、长期稳定、严格保密（轮换会使所有已签发 token 失效）
#   生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# 首个 super admin（平台唯一可删 KB / 可访问 /admin/*）
LIGHTRAG_SUPER_ADMIN_USERNAME=admin
# 【必改】生产用 bcrypt 哈希，避免明文落盘：
#   生成：python -c "from lightrag.api.passwords import hash_password; print(hash_password('你的强密码'))"
LIGHTRAG_SUPER_ADMIN_PASSWORD_HASH={bcrypt}$2b$12$REPLACE_WITH_BCRYPT_HASH
# 仅首次开发引导可临时用明文（与上面二选一；生产请删除/留空）：
# LIGHTRAG_SUPER_ADMIN_PASSWORD=change-me

# 注册策略：内网自管建议关闭，由管理员通过 /admin/users 建号
LIGHTRAG_USER_REGISTRATION_ENABLED=false
# 可选运行时模式（也可经 PATCH /admin/settings/registration 切换）：disabled / open / invite_only / admin_approval

# 全局 API Key：【必改或留空】企业模式下默认不绕过 RBAC（anti-bypass），作用很有限。
#   程序/自动化调用请改用 service API key（POST /admin/service-api-keys，可按 KB 授角色/过期/吊销）。
LIGHTRAG_API_KEY=CHANGE_ME_OR_LEAVE_FOR_LEGACY_ONLY
LIGHTRAG_ENTERPRISE_LEGACY_API_KEY_SUPERADMIN=false   # 【勿改】保持 false，不让全局 key 充当超管

# 企业治理（推荐值）
LIGHTRAG_ENTERPRISE_DISABLE_GLOBAL_ROUTES=true        # 禁用 legacy /documents、/query、/graph、/api 全局路由
LIGHTRAG_ENTERPRISE_MASK_STORAGE_URIS=true            # 响应中隐藏本地路径/对象存储 URI
LIGHTRAG_ENTERPRISE_ARTIFACT_DOWNLOAD_MIN_ROLE=kb_viewer   # 产物下载最低角色，可提为 kb_editor/kb_admin

# 登录/注册失败锁定（默认开启，MAX_ATTEMPTS=0 关闭）
LIGHTRAG_ENTERPRISE_LOGIN_MAX_ATTEMPTS=10
LIGHTRAG_ENTERPRISE_LOGIN_WINDOW_SECONDS=300
LIGHTRAG_ENTERPRISE_LOGIN_LOCKOUT_SECONDS=900

# 限流/配额：内网信任度高可保持关闭；需要时再开（本地 LLM 不做 token/成本计费）
# LIGHTRAG_ENTERPRISE_RATE_LIMIT_ENABLED=false
# LIGHTRAG_ENTERPRISE_MAX_CONCURRENT_JOBS=0           # per-principal 在途 job 上限，0=不限


# -----------------------------------------------------------------------------
# 3. 本地模型服务（LLM / Embedding / Rerank / VLM）—— 地址【必改】为你的内网服务
# -----------------------------------------------------------------------------
# 主 LLM
LLM_BINDING=openai
LLM_BINDING_HOST=http://192.168.1.66:8000/v1
LLM_BINDING_API_KEY=local-dummy-key          # 本地服务若无鉴权可填占位；有则【必改】
LLM_MODEL=qwen3.6-36b
MAX_ASYNC=8
LLM_TIMEOUT=600
OPENAI_LLM_MAX_TOKENS=32768
OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# 按角色覆盖（抽取/关键词/查询/Agent/Profile/VLM）——多 KB 合并查询用的就是这套统一模型
EXTRACT_LLM_MODEL=qwen3.6-36b
EXTRACT_MAX_ASYNC_LLM=8
EXTRACT_LLM_TIMEOUT=600
EXTRACT_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
KEYWORD_LLM_MODEL=qwen3.6-36b
KEYWORD_MAX_ASYNC_LLM=8
KEYWORD_LLM_TIMEOUT=300
KEYWORD_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
QUERY_LLM_MODEL=qwen3.6-36b
QUERY_MAX_ASYNC_LLM=8
QUERY_LLM_TIMEOUT=600
QUERY_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": true}}'

# Agent 编排角色：用于 JSON 规划/决策；同端点同模型，建议关闭思考以稳定 JSON 输出
AGENT_LLM_MODEL=qwen3.6-36b
AGENT_MAX_ASYNC_LLM=1
AGENT_LLM_TIMEOUT=300
AGENT_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
LIGHTRAG_AGENT_QUERY_ENABLED=false
AGENT_MAX_ROUNDS=5
AGENT_WORKFLOW_PROMPT_MAX_LENGTH=16384
LIGHTRAG_AGENT_PROFILE_AUTO_REFRESH=true
AGENT_PROFILE_REFRESH_DOC_DELTA=1
AGENT_PROFILE_REFRESH_MIN_INTERVAL_SECONDS=0

# Profile 生成角色：用于文档级 profile → KB 级 Agent profile 自动生成，建议关闭思考以稳定 JSON 输出
PROFILE_LLM_MODEL=qwen3.6-36b
PROFILE_MAX_ASYNC_LLM=1
PROFILE_LLM_TIMEOUT=300
PROFILE_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# 视觉模型（多模态解析/图片分析）
VLM_LLM_MODEL=qwen3.6-36b-vision
VLM_LLM_BINDING_API_KEY=local-dummy-key      # 有鉴权则【必改】
VLM_PROCESS_ENABLE=true
VLM_MAX_IMAGE_BYTES=5242880
VLM_MAX_ASYNC_LLM=8
VLM_LLM_TIMEOUT=600

# Embedding（dim/model 变更会触发重建，务必与已有数据一致）
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://192.168.1.66:8002/v1
EMBEDDING_BINDING_API_KEY=local-dummy-key    # 有鉴权则【必改】
EMBEDDING_MODEL=qwen-embed
EMBEDDING_DIM=4096                            # 【勿轻改】与向量库已存维度必须一致
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_TIMEOUT=120
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=32
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true

# Rerank（跨多 KB 合并检索的统一重排器）
RERANK_BINDING=cohere
RERANK_BINDING_HOST=http://192.168.1.66:8003/v1/rerank
RERANK_MODEL=qwen3-rerank
RERANK_BY_DEFAULT=True
MIN_RERANK_SCORE=0.0
MAX_ASYNC_RERANK=1
RERANK_TIMEOUT=60


# -----------------------------------------------------------------------------
# 4. 解析服务（MinerU / Docling）—— 地址【必改】，且依赖外部服务在线
# -----------------------------------------------------------------------------
# 按文件类型路由：pdf→MinerU(iteP)，office→Docling(iteP)，其余→legacy
LIGHTRAG_PARSER=pdf:mineru-iteP,docx:docling-iteP,pptx:docling-iteP,xlsx:docling-iteP,*:legacy-R

# MinerU（本地）
MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://192.168.1.66:8005
MINERU_LOCAL_BACKEND=vlm-http-client
MINERU_VLM_URL=http://192.168.1.66:8001
MINERU_VLM_MODEL=MinerU2.5-Pro-2B
MINERU_LOCAL_PARSE_METHOD=auto
MINERU_LOCAL_IMAGE_ANALYSIS=true
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_MAX_POLLS=600

# Docling（office 解析）
DOCLING_ENDPOINT=http://192.168.1.66:8006
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=false
DOCLING_DO_FORMULA_ENRICHMENT=false

# 摘要/抽取语言、上传上限
SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true
MAX_UPLOAD_SIZE=104857600          # 100MB；按需调整，0/未配置会拒绝上传(413)


# -----------------------------------------------------------------------------
# 5. 引擎存储后端（底层 RAG 数据：KV/状态/图谱/向量）—— 密钥【必改】
# -----------------------------------------------------------------------------
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# PostgreSQL（KV / doc status）
POSTGRES_HOST=192.168.1.66
POSTGRES_PORT=5433
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME       # 【必改】
POSTGRES_DATABASE=knowledge_base
POSTGRES_MAX_CONNECTIONS=25

# Neo4j（知识图谱）
NEO4J_URI=bolt://192.168.1.66:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME           # 【必改】
NEO4J_DATABASE=neo4j

# Milvus（向量）
MILVUS_URI=http://192.168.1.66:19530
MILVUS_DB_NAME=lightrag
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE


# -----------------------------------------------------------------------------
# 6. KB 控制面 metadata（知识库目录/文档/任务/配置版本/企业用户·租户·ACL·审计）
# -----------------------------------------------------------------------------
LIGHTRAG_KB_METADATA_BACKEND=postgres        # 企业部署用 postgres；留空/local 则用 SQLite(仅单机轻量)
LIGHTRAG_KB_POSTGRES_HOST=192.168.1.66
LIGHTRAG_KB_POSTGRES_PORT=5433
LIGHTRAG_KB_POSTGRES_USER=admin
LIGHTRAG_KB_POSTGRES_PASSWORD=CHANGE_ME       # 【必改】
LIGHTRAG_KB_POSTGRES_DATABASE=knowledge_base
LIGHTRAG_KB_POSTGRES_POOL_MIN_SIZE=1
LIGHTRAG_KB_POSTGRES_POOL_MAX_SIZE=10


# -----------------------------------------------------------------------------
# 7. 对象存储（源文件 / 解析产物持久化到 MinIO，本地 INPUT_DIR 作缓存）
# -----------------------------------------------------------------------------
LIGHTRAG_OBJECT_STORAGE=minio                # 不需要可设 local（仅本地磁盘）
LIGHTRAG_OBJECT_STORAGE_ENDPOINT=http://192.168.1.66:19000
LIGHTRAG_OBJECT_STORAGE_BUCKET=lightrag-kb
LIGHTRAG_OBJECT_STORAGE_ACCESS_KEY_ID=admin
LIGHTRAG_OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME   # 【必改】
LIGHTRAG_OBJECT_STORAGE_USE_SSL=false
LIGHTRAG_OBJECT_STORAGE_REGION=us-east-1
LIGHTRAG_OBJECT_STORAGE_PREFIX=kb
LIGHTRAG_OBJECT_STORAGE_CREATE_BUCKET=true
LIGHTRAG_OBJECT_STORAGE_DISABLE_EXPECT_HEADER=true    # 兼容部分 MinIO/反代的 100-continue 挂起


# -----------------------------------------------------------------------------
# 8. 任务编排与并发（单机容量，按 GPU/后端承受能力【可调】）
# -----------------------------------------------------------------------------
LIGHTRAG_KB_JOB_WORKER=true        # 开启 durable worker：崩溃/重启续跑、:retry 自动消费
MAX_PARALLEL_PARSE_MINERU=4        # MinerU 并发解析上限（聚合任务 Phase 1）
MAX_PARALLEL_PARSE_DOCLING=2
MAX_PARALLEL_ANALYZE=8
MAX_PARALLEL_INSERT=3
QUEUE_SIZE_DEFAULT=100
QUEUE_SIZE_INSERT=4


# -----------------------------------------------------------------------------
# 9. 检索/分块 默认值（服务级默认；各 KB 可经配置版本接口覆盖）【可调】
# -----------------------------------------------------------------------------
ENABLE_LLM_CACHE=true
COSINE_THRESHOLD=0.2
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
KG_CHUNK_PICK_METHOD=VECTOR
RELATED_CHUNK_NUMBER=5
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
CHUNK_P_SIZE=2000
CHUNK_P_OVERLAP_SIZE=100


# =============================================================================
# 外部依赖提醒（不在本服务管辖，但部署时必须确认在线/配置正确）：
#   - 上述 192.168.1.66 上的 PG(5433) / Neo4j(7687) / Milvus(19530) / MinIO(19000)
#   - 模型服务：LLM(8000) / VLM(8001) / Embedding(8002) / Rerank(8003)
#   - 解析服务：MinerU(8005, VLM 8001) / docling-serve(8006)
#     · docling-serve 需以单 worker 运行（UVICORN_WORKERS=1），否则异步任务可能 404
#     · MinerU 若以 0.0.0.0 暴露且用 vlm-http-client，注意其 SSRF 防护（--host 或 --allow-public-http-client）
# 首次启动：企业模式会自动建企业表、bootstrap super admin、现有 KB 归 default tenant、
#           super admin 获全部 KB 访问。
# =============================================================================
