# =============================================================================
# LightRAG 企业级 · 单机内网 部署配置（2026-07-22 精简整理版）
# =============================================================================
# 场景：单台服务器、内网使用、企业认证开启（多用户/RBAC/多租户/审计），
#       对接独立前端；所有 KB 共享同一组本地模型/解析服务。
# 上一版完整配置已备份为 .env.backup.20260722。
#
# 部署动作清单：
#   1) chmod 600 .env （内含数据库/对象存储密钥）
#   2) 防火墙将 9621 限制在内网网段
#   3) 首次登录 super admin 后立即 POST /auth/change-password 改掉初始密码
#   4) 前端域名确定后，把 CORS_ORIGINS 收紧为具体 origin
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 基础运行
# -----------------------------------------------------------------------------
LIGHTRAG_RUNTIME_TARGET=host
HOST=0.0.0.0                       # 监听所有网卡；务必用防火墙限制访问来源
PORT=9621
WORKERS=1                          # 【勿改】durable worker 与流水线按单进程设计
TIMEOUT=600
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
TIKTOKEN_CACHE_DIR=./data/tiktoken # 离线部署必须预缓存：联网先启动一次让其下载
WORKSPACE=
LOG_LEVEL=INFO
VERBOSE=False
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# -----------------------------------------------------------------------------
# 2. 前端对接（CORS / 会话时长）
# -----------------------------------------------------------------------------
# 联调期先放本机；前端域名定下来后改为具体 origin，例如：
#   CORS_ORIGINS=http://192.168.1.80:5173,http://kb.internal.example
CORS_ORIGINS=http://localhost:9621,http://127.0.0.1:9621
# JWT 有效期（小时）。到期前端需重新 POST /login；改密/登出/管理员禁用会立即失效全部 token。
TOKEN_EXPIRE_HOURS=48


# -----------------------------------------------------------------------------
# 3. 企业认证（多用户 / RBAC / 多租户 / 审计 / service key）
# -----------------------------------------------------------------------------
LIGHTRAG_ENTERPRISE_AUTH_ENABLED=true

# JWT 签名密钥（强随机；轮换会使所有已签发 token 失效）
TOKEN_SECRET=D4NXZtzBjVi1drKikF_8reGplTxUqPVIqvLhH7eSLhhJzmUis5vtjjZVN1cN2MA_

# super admin 引导 —— 采用模式 A（PASSWORD 仅用于首次建号）：
#   仅当企业用户表中不存在该用户时用此明文建号；用户已存在则保留数据库现有密码。
#   因此 POST /auth/change-password 改密后持久生效，重启不会被 .env 回滚。
#   ⚠️ 切勿再同时设置 LIGHTRAG_SUPER_ADMIN_PASSWORD_HASH——HASH 优先，会变成
#   "每次重启强制覆盖回该哈希"的模式 B，API 改密只活到下次重启。
#   初始密码首次登录后立即经 API 改掉。
LIGHTRAG_SUPER_ADMIN_USERNAME=admin
LIGHTRAG_SUPER_ADMIN_PASSWORD=Admin@12345

# 注册策略：内网自管，关闭注册、管理员经 /admin/users 建号；
# 前端要测注册流程时运行时切换：PATCH /admin/settings/registration {"mode":"open"|"invite_only"|"admin_approval"}
LIGHTRAG_USER_REGISTRATION_ENABLED=false

# 全局 API Key：企业模式下不绕过 RBAC（anti-bypass），仅 legacy 兼容用途；
# 程序化/前端服务端调用请用 service API key（POST /admin/service-api-keys）。
# 无 legacy 调用方时建议整行删除，减少一个长期凭证。
LIGHTRAG_API_KEY=lrk-AHD5o5N-e18Cn_ky0p8ffZbNYMWca2o4
LIGHTRAG_ENTERPRISE_LEGACY_API_KEY_SUPERADMIN=false   # 【勿改】不让全局 key 充当超管

# 企业治理（推荐值）
LIGHTRAG_ENTERPRISE_DISABLE_GLOBAL_ROUTES=true        # 禁用 legacy /documents /query /graph /api 全局路由
LIGHTRAG_ENTERPRISE_MASK_STORAGE_URIS=true            # 响应中隐藏本地路径/对象存储 URI
LIGHTRAG_ENTERPRISE_ARTIFACT_DOWNLOAD_MIN_ROLE=kb_viewer
LIGHTRAG_ENTERPRISE_TENANT_ADMIN_OVERSIGHT_ROLE=kb_admin   # 租户管理员对本租户所有 KB（含成员私有 KB）的监察保底角色：kb_viewer/kb_editor/kb_admin

# 登录失败锁定（同名连续失败 N 次锁 LOCKOUT 秒；MAX_ATTEMPTS=0 关闭）
LIGHTRAG_ENTERPRISE_LOGIN_MAX_ATTEMPTS=10
LIGHTRAG_ENTERPRISE_LOGIN_WINDOW_SECONDS=300
LIGHTRAG_ENTERPRISE_LOGIN_LOCKOUT_SECONDS=900

# 限流/配额：内网联调期保持关闭；需要时再开
# LIGHTRAG_ENTERPRISE_RATE_LIMIT_ENABLED=false
# LIGHTRAG_ENTERPRISE_MAX_CONCURRENT_JOBS=0

# --- 多账号身份关联与切换（Person Auth，详见 docs/多账号身份关联与切换执行文档.md）---
# 同一自然人可关联多个部门账号并随时切换；依赖企业认证（上方开关必须为 true）。
LIGHTRAG_PERSON_AUTH_ENABLED=true
# v2 person JWT 独立签名密钥：必须非默认值且不同于 TOKEN_SECRET（回滚安全）；轮换会使全部 person token 失效
LIGHTRAG_PERSON_TOKEN_SECRET=xq64XmiV8PfpUZ6iPrm0ede4-lpBaOws8W0MMZ_hJetmCVdXxrBiEMSHwQLlu5sW
# person access token / session 生命周期（秒）：switch 不延长 session 绝对过期
LIGHTRAG_PERSON_ACCESS_TOKEN_TTL=3600
LIGHTRAG_PERSON_SESSION_TTL=28800
# 自然人密码策略与锁定（login/confirm-link/change-password 共用同一失败计数）
LIGHTRAG_PERSON_PASSWORD_MIN_LENGTH=8
LIGHTRAG_PERSON_LOGIN_MAX_ATTEMPTS=5
LIGHTRAG_PERSON_LOGIN_LOCKOUT_SECONDS=900
# 公开 enroll 端点按客户端地址限流（防 grant 猜测；MAX_ATTEMPTS=0 关闭）
LIGHTRAG_PERSON_ENROLL_MAX_ATTEMPTS=10
LIGHTRAG_PERSON_ENROLL_WINDOW_SECONDS=300
LIGHTRAG_PERSON_ENROLL_LOCKOUT_SECONDS=900


# -----------------------------------------------------------------------------
# 4. 本地模型服务（全部 KB 共享同一组部署）
# -----------------------------------------------------------------------------
# 主 LLM（vLLM OpenAI-compatible）
LLM_BINDING=openai
LLM_BINDING_HOST=http://192.168.1.66:8000/v1
LLM_BINDING_API_KEY=sk-123456
OPENAI_API_KEY=sk-123456           # 【保留】openai.py / docx 解析器仍直接读取此变量
LLM_MODEL=qwen3.6-35b
MAX_ASYNC=8
LLM_TIMEOUT=600
OPENAI_LLM_MAX_TOKENS=32768
# 全局 thinking 兜底：关闭思考；各角色再按需覆盖（extra_body 为整体替换，非深合并）
OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# 按角色拆分（当前同端点同模型，仅区分带不带思考；保留字段便于后期换模型）：
#   EXTRACT 抽取建图 / KEYWORD 查询关键词 → 关闭思考；QUERY 最终问答 → 开启思考
EXTRACT_LLM_MODEL=qwen3.6-35b
EXTRACT_MAX_ASYNC_LLM=8
EXTRACT_LLM_TIMEOUT=600
EXTRACT_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
KEYWORD_LLM_MODEL=qwen3.6-35b
KEYWORD_MAX_ASYNC_LLM=8
KEYWORD_LLM_TIMEOUT=300
KEYWORD_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
QUERY_LLM_MODEL=qwen3.6-35b
QUERY_MAX_ASYNC_LLM=8
QUERY_LLM_TIMEOUT=600
QUERY_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": true}}'

# Agent 模式编排角色（JSON 规划/决策；关闭思考以稳定 JSON 输出）
AGENT_LLM_MODEL=qwen3.6-35b
AGENT_MAX_ASYNC_LLM=1
AGENT_LLM_TIMEOUT=300
AGENT_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
LIGHTRAG_AGENT_QUERY_ENABLED=true
AGENT_MAX_ROUNDS=5
# 基础多 KB 问答选库上限（-1 表示不限；正整数设置硬上限）
MULTI_KB_QUERY_MAX_KBS=-1
# 阶段化配比推荐工作流（workflow="staged"）：单会话检索步数硬上限
AGENT_STAGED_MAX_RETRIEVALS=24
# staged 每个检索步最多同时查询的 KB 数；超限按 agent_priority 择优并记入 metadata.clipped
AGENT_STAGED_MAX_KBS_PER_STEP=4
AGENT_WORKFLOW_PROMPT_MAX_LENGTH=16384
LIGHTRAG_AGENT_PROFILE_AUTO_REFRESH=true
AGENT_PROFILE_REFRESH_DOC_DELTA=1
AGENT_PROFILE_REFRESH_MIN_INTERVAL_SECONDS=0

# Profile 生成角色（文档级 profile → KB 级 Agent profile；关闭思考以稳定 JSON 输出）
PROFILE_LLM_MODEL=qwen3.6-35b
PROFILE_MAX_ASYNC_LLM=1
PROFILE_LLM_TIMEOUT=300
PROFILE_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# 视觉模型（多模态解析/图片分析；HOST/KEY 未设时继承全局 LLM）
VLM_LLM_MODEL=qwen3.6-35b-vision
VLM_LLM_BINDING_API_KEY=sk-123456
VLM_PROCESS_ENABLE=true
VLM_MAX_IMAGE_BYTES=5242880
VLM_MAX_ASYNC_LLM=8
VLM_LLM_TIMEOUT=600

# Embedding（⚠️ model/dim 与向量库已存数据强绑定，改动需整库重建）
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://192.168.1.66:8002/v1
EMBEDDING_BINDING_API_KEY=sk-123456
EMBEDDING_MODEL=qwen-embed
EMBEDDING_DIM=4096
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_TIMEOUT=120
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=32
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true

# Rerank（跨 KB 合并检索的统一重排器；服务按串行使用）
RERANK_BINDING=cohere
RERANK_BINDING_HOST=http://192.168.1.66:8003/v1/rerank
RERANK_MODEL=qwen3-rerank
RERANK_BY_DEFAULT=True
MIN_RERANK_SCORE=0.0
MAX_ASYNC_RERANK=1
RERANK_TIMEOUT=60


# -----------------------------------------------------------------------------
# 5. 对话与项目级记忆（/chat + graphiti，docs/ChatMemory-zh.md）
# -----------------------------------------------------------------------------
# 用户对话管理（/chat）：新建会话的默认上下文轮次；-1 表示每次把全部历史发给大模型
CHAT_SESSION_DEFAULT_CONTEXT_ROUNDS=1

# /chat 落库的问答异步提炼为 Neo4j 时序知识图谱（按 用户+项目 隔离），
# 新会话经 POST /chat/projects/{id}/memory:search 召回历史事实。
# 依赖：uv sync --extra memory（graphiti-core）；Neo4j server 需 >= 5.26
LIGHTRAG_CHAT_MEMORY_ENABLED=true
# 维护 worker（PostgreSQL outbox，durable：崩溃/重启续跑）——当前可靠性机制
LIGHTRAG_CHAT_MEMORY_MAINTENANCE_ENABLED=true
LIGHTRAG_CHAT_MEMORY_WORKER_POLL_SECONDS=1.0
LIGHTRAG_CHAT_MEMORY_WORKER_RECOVERY_INTERVAL_SECONDS=30.0
LIGHTRAG_CHAT_MEMORY_WORKER_SIDE_EFFECT_TIMEOUT_SECONDS=900.0
LIGHTRAG_CHAT_MEMORY_WORKER_SHUTDOWN_TIMEOUT_SECONDS=10.0
LIGHTRAG_CHAT_MEMORY_REBUILD_MAX_MESSAGES=10000
LIGHTRAG_CHAT_MEMORY_REBUILD_MAX_BYTES=67108864
# 隐私：不在 Neo4j 存第二份原始对话内容（SQL 消息表仍可用于 rebuild）
LIGHTRAG_CHAT_MEMORY_STORE_RAW_EPISODE_CONTENT=false
# 最终合成时记忆片段的独立预算
LIGHTRAG_CHAT_MEMORY_PROMPT_MAX_TOKENS=1024
LIGHTRAG_CHAT_MEMORY_PROMPT_MAX_CHARS=8192
# 默认拒绝跨 provider 记忆外发：问答 LLM 端点必须与记忆抽取 LLM 端点一致
LIGHTRAG_CHAT_MEMORY_ALLOW_CROSS_PROVIDER_QUERY_EGRESS=false

# 记忆抽取 LLM：显式钉死到主 vLLM 服务（保留字段便于后期换专用记忆模型）
MEMORY_LLM_BINDING_HOST=http://192.168.1.66:8000/v1
MEMORY_LLM_BINDING_API_KEY=sk-123456
MEMORY_LLM_MODEL=qwen3.6-35b
MEMORY_LLM_TIMEOUT=300
MEMORY_LLM_TEMPERATURE=0.0
# 抽取要求稳定 JSON 输出：vLLM json_schema 约束解码 + 关闭思考模式
MEMORY_STRUCTURED_OUTPUT_MODE=json_schema
MEMORY_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# 记忆 embedding：与部署共用同一 embedding 服务（qwen-embed，dim 4096）
MEMORY_EMBEDDING_BINDING_HOST=http://192.168.1.66:8002/v1
MEMORY_EMBEDDING_BINDING_API_KEY=sk-123456
MEMORY_EMBEDDING_MODEL=qwen-embed
MEMORY_EMBEDDING_DIM=4096
# 记忆图存储：缺省继承 NEO4J_*（同实例同库，graphiti 用独立 label+group_id 隔离）
# MEMORY_NEO4J_URI=bolt://192.168.1.66:7687
# MEMORY_NEO4J_DATABASE=neo4j
# 图存储身份标识。【勿改勿删】已写入记忆数据后变更会导致既有 group 拒写（HTTP 409）
MEMORY_NEO4J_DEPLOYMENT_ID=lightrag-primary-d3ee558313af
# 行为参数：检索默认条数 / 全局摄取并发 / graphiti 内部并发 / 单条消息截断长度
MEMORY_SEARCH_LIMIT=10
MEMORY_INGEST_CONCURRENCY=2
MEMORY_MAX_COROUTINES=4
MEMORY_INGEST_MAX_CHARS=6000
# 记忆检索用部署 reranker 精排（qwen3-rerank）；关闭则用 RRF
MEMORY_RERANK_ENABLED=true
# —— 以下为 legacy 直调路径参数（企业模式走 outbox worker，不依赖它们）；
#    当前值均等于代码默认值，注释保留仅作文档用途 ——
# MEMORY_INGEST_MODE=immediate
# MEMORY_INGEST_DEBOUNCE_SECONDS=20
# MEMORY_BACKLOG_SCAN_ON_START=true
# MEMORY_BACKLOG_BATCH_MESSAGES=20
# MEMORY_MAX_INFLIGHT_PER_USER=8

# graphiti 匿名遥测：内网部署关闭
GRAPHITI_TELEMETRY_ENABLED=false


# -----------------------------------------------------------------------------
# 6. 解析服务（MinerU / Docling）
# -----------------------------------------------------------------------------
# 按后缀路由：pdf→MinerU(iteP)；office/csv→Docling(iteP)；其余→legacy。
# 老式二进制 doc/ppt/xls 先用同机 LibreOffice 转为 OOXML，再交给 Docling。
# ⚠️ KB 级 parser_config.engine 一旦设置会整库覆盖此路由；要保持混合路由，各 KB 勿锁定 engine。
LIGHTRAG_PARSER=pdf:mineru-iteP,doc:docling-iteP,ppt:docling-iteP,xls:docling-iteP,docx:docling-iteP,pptx:docling-iteP,xlsx:docling-iteP,csv:docling-iteP,*:legacy-R

# MinerU（自部署 mineru-api，含 /tasks 任务接口；经 vlm-http-client 调 8001 的 VLM）
MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://192.168.1.66:8005
MINERU_LOCAL_BACKEND=vlm-http-client
MINERU_VLM_URL=http://192.168.1.66:8001
MINERU_VLM_MODEL=MinerU2.5-Pro-2B
MINERU_LOCAL_PARSE_METHOD=auto
MINERU_LOCAL_IMAGE_ANALYSIS=false
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
# 轮询间隔与绝对任务时限：大 PDF/VLM 冷启动按最长 60 分钟等待。
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_TASK_TIMEOUT_SECONDS=3600

# Docling（docling-serve v1 异步 API，仅 base URL）
# ⚠️ docling-serve 侧必须 UVICORN_WORKERS=1，否则异步任务跨进程 404
DOCLING_ENDPOINT=http://192.168.1.66:8006
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=false
DOCLING_DO_FORMULA_ENRICHMENT=false

# LibreOffice（同机命令行转换：doc/ppt/xls → docx/pptx/xlsx，再交给 Docling）
ENABLE_LIBREOFFICE_CONVERSION=true
LIBREOFFICE_EXECUTABLE=soffice
LIBREOFFICE_TIMEOUT_SECONDS=120
LIBREOFFICE_FORCE_RECONVERT=false

# 摘要/抽取语言、上传上限
SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true
MAX_UPLOAD_SIZE=104857600          # 100MB


# -----------------------------------------------------------------------------
# 7. 引擎存储后端（KV/DocStatus→PG，Graph→Neo4j，Vector→Milvus，全外部共享）
# -----------------------------------------------------------------------------
# ⚠️ Neo4j 驱动为可选依赖：部署机需 uv sync --extra offline-storage（或安装 neo4j>=5,<7）
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# PostgreSQL（引擎 KV / doc status；与 KB 控制面共库，表名不冲突）
POSTGRES_HOST=192.168.1.66
POSTGRES_PORT=5433
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=knowledge_base
POSTGRES_MAX_CONNECTIONS=25

# Neo4j（知识图谱；多 KB 靠 workspace label 隔离。切勿设置 NEO4J_WORKSPACE——会破坏 KB 隔离）
NEO4J_URI=bolt://192.168.1.66:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=LightRag@2026
NEO4J_DATABASE=neo4j

# Milvus（向量）
MILVUS_URI=http://192.168.1.66:19530
MILVUS_DB_NAME=lightrag
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE


# -----------------------------------------------------------------------------
# 8. KB 控制面 metadata（KB 目录/文档/任务/配置版本 + 企业用户·租户·ACL·审计）
# -----------------------------------------------------------------------------
LIGHTRAG_KB_METADATA_BACKEND=postgres
LIGHTRAG_KB_POSTGRES_HOST=192.168.1.66
LIGHTRAG_KB_POSTGRES_PORT=5433
LIGHTRAG_KB_POSTGRES_USER=admin
LIGHTRAG_KB_POSTGRES_PASSWORD=123456
LIGHTRAG_KB_POSTGRES_DATABASE=knowledge_base
LIGHTRAG_KB_POSTGRES_POOL_MIN_SIZE=1
LIGHTRAG_KB_POSTGRES_POOL_MAX_SIZE=10
LIGHTRAG_KB_POSTGRES_OPERATION_LOCK_POOL_MAX_SIZE=10  # KB generation fence / Job owner advisory lock 专用连接池


# -----------------------------------------------------------------------------
# 9. 对象存储（源文件/解析产物持久化到 MinIO；INPUT_DIR 仅作本地缓存）
# -----------------------------------------------------------------------------
LIGHTRAG_OBJECT_STORAGE=minio
LIGHTRAG_OBJECT_STORAGE_ENDPOINT=http://192.168.1.66:19000
LIGHTRAG_OBJECT_STORAGE_BUCKET=lightrag-kb
LIGHTRAG_OBJECT_STORAGE_ACCESS_KEY_ID=admin
LIGHTRAG_OBJECT_STORAGE_SECRET_ACCESS_KEY=admin123
LIGHTRAG_OBJECT_STORAGE_USE_SSL=false
LIGHTRAG_OBJECT_STORAGE_REGION=us-east-1
LIGHTRAG_OBJECT_STORAGE_PREFIX=kb
LIGHTRAG_OBJECT_STORAGE_CREATE_BUCKET=true
LIGHTRAG_OBJECT_STORAGE_DISABLE_EXPECT_HEADER=true


# -----------------------------------------------------------------------------
# 10. 任务编排与并发（按 GPU/后端承受能力调整）
# -----------------------------------------------------------------------------
LIGHTRAG_KB_JOB_WORKER=true        # durable worker：崩溃/重启续跑、:retry 自动消费
LIGHTRAG_KB_JOB_WORKER_POLL_SECONDS=1.0
LIGHTRAG_KB_JOB_WORKER_GRACE_SECONDS=5.0
LIGHTRAG_KB_JOB_RECOVERY_INTERVAL_SECONDS=30.0
LIGHTRAG_KB_JOB_RECOVERY_GRACE_SECONDS=5.0
MAX_PARALLEL_PARSE_MINERU=2        # 单 vLLM 保守并发，避免排队时间侵占 MinerU 任务时限
MAX_PARALLEL_PARSE_DOCLING=2
MAX_PARALLEL_ANALYZE=8
MAX_PARALLEL_INSERT=3
QUEUE_SIZE_DEFAULT=100
QUEUE_SIZE_INSERT=4


# -----------------------------------------------------------------------------
# 11. 检索/分块 服务级默认（各 KB 可经 /kbs/{id}/configs 覆盖）
# -----------------------------------------------------------------------------
ENABLE_LLM_CACHE=true
COSINE_THRESHOLD=0.2
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
KG_CHUNK_PICK_METHOD=VECTOR
RELATED_CHUNK_NUMBER=5
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
CHUNK_P_SIZE=2000                  # 段落语义分块(P)主用；不回退 CHUNK_SIZE
CHUNK_P_OVERLAP_SIZE=100

# 双语双路检索（docs/BilingualQuery-zh.md）：中英混合语料的跨语言召回
# 总开关；KB 级用 query_config.bilingual_query (off/auto/on)，请求级用 body.bilingual
# auto=仅中文（含CJK）查询走双路；依赖多语言 embedding(qwen-embed)+rerank(qwen3-rerank)，已满足
BILINGUAL_QUERY_ENABLED=true
BILINGUAL_QUERY_DEFAULT_MODE=auto
BILINGUAL_QUERY_TIMEOUT=12
# 翻译模型（BILINGUAL 角色）：未设置的字段逐项继承 QUERY 角色 → 基础 LLM；
# 后续换专用翻译模型时取消注释：
# BILINGUAL_LLM_MODEL=
# BILINGUAL_LLM_BINDING=openai
# BILINGUAL_LLM_BINDING_HOST=
# BILINGUAL_LLM_BINDING_API_KEY=
# BILINGUAL_MAX_ASYNC_LLM=4
# BILINGUAL_LLM_TIMEOUT=60
# BILINGUAL_OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'


# -----------------------------------------------------------------------------
# 12. 可观测性
# -----------------------------------------------------------------------------
LANGFUSE_TRACING_ENABLED=false


# =============================================================================
# 外部依赖（部署前确认在线）：
#   PG(5433) / Neo4j(7687) / Milvus(19530) / MinIO(19000)
#   LLM(8000) / VLM(8001) / Embedding(8002) / Rerank(8003)
#   MinerU(8005，VLM 走 8001) / docling-serve(8006，必须单 worker)
# 首次启动：自动建企业表、bootstrap super admin、现有 KB 归 default tenant。
# 验证：GET /health → GET /auth-status → POST /login → GET /admin/overview
